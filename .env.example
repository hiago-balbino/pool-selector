# API server port
PORT=5050

# Data source: "local" or "s3"
DATA_SOURCE=local

# LocalFileSource: directory to read JSON event files from
LOCAL_DATA_DIR=./data

# S3Source: bucket and prefix to read JSON event files from
S3_BUCKET=
S3_PREFIX=

# Recency window used by SlidingWindowStrategy, in minutes
RECENCY_WINDOW_MINUTES=60

# Minimum sample size below which a pool's confidence is marked "low"
LOW_CONFIDENCE_THRESHOLD=5

# Interval between background refreshes of the aggregated pool stats, in seconds
REFRESH_INTERVAL_SECONDS=60
